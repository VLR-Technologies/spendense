# Safe default. Missing/unknown values also use maintenance.
# maintenance / staging: holding page; no sign-in or financial reads/writes.
# live: full existing app. Enable only after the launch checklist is approved.
NEXT_PUBLIC_APP_MODE=maintenance
# Leave both empty until the real backend is validated. No substitutes are needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical HTTPS app origin when activating cloud, e.g. https://spendense.example.
NEXT_PUBLIC_APP_URL=
# Browser-safe publishable/legacy anon key only. Never use a service-role/secret key.
# All NEXT_PUBLIC_* values are bundled at build time. Rebuild after changes.
